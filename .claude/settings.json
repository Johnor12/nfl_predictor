{
  "extraKnownMarketplaces": {
    "nfl-predictor": { "source": { "source": "directory", "path": "./.claude/lsp" } }
  },
  "enabledPlugins": {
    "pyright-uv@nfl-predictor": true,
    "pyright-lsp@claude-plugins-official": false
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null || exit 0; node \"$CLAUDE_PROJECT_DIR/.claude/keepalive/keepalive.js\" busy",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null || exit 0; node \"$CLAUDE_PROJECT_DIR/.claude/keepalive/keepalive.js\" busy",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null || exit 0; node \"$CLAUDE_PROJECT_DIR/.claude/keepalive/keepalive.js\" idle",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
